# MySQL connection string
DATABASE_URL=mysql://user:password@localhost:3306/whizzolabs

# Set to "true" to allow admin access without Auth.js (development only)
ADMIN_BYPASS=true

# Auth.js
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin user (used by npm run db:admin)
ADMIN_EMAIL=admin@whizzolabs.com
ADMIN_PASSWORD=changeme123
